@model Turnos.Models.Medico

<h4>Eliminar Medico</h4>
<hr />
<h5>Esta usted seguro de eliminar el siguinte registro?</h5>
<div>
    <div class="row z-depth-3  blue lighten-4">
        <div class="input-field col s6">
            <i class="material-icons prefix">account_circle</i>
            <input asp-for="Nombre" type="text" class="validate" disabled>
            <label asp-for="Nombre">Nombre</label>
            <span asp-validation-for="Nombre"></span>
        </div>
        <div class="input-field col s6">
            <i class="material-icons prefix">account_circle</i>
            <input asp-for="Apellido" type="text" class="validate" disabled>
            <label asp-for="Apellido">Apellido</label>
            <span asp-validation-for="Apellido"></span>
        </div>
        <div class="input-field col s6">
            <i class="material-icons prefix">share_location</i>
            <input asp-for="Direccion" type="text" class="validate" disabled>
            <label asp-for="Direccion">Direccion</label>
            <span asp-validation-for="Direccion"></span>
        </div>
        <div class="input-field col s6">
            <i class="material-icons prefix">phone</i>
            <input asp-for="Telefono" type="tel" class="validate" disabled>
            <label asp-for="Telefono">Telefono</label>
            <span asp-validation-for="Telefono"></span>
        </div>
        <div class="input-field col s6">
            <i class="material-icons prefix">local_post_office</i>
            <input asp-for="Email" type="email" class="validate" disabled>
            <label asp-for="Email">Email</label>
            <span asp-validation-for="Email"></span>
        </div>
        <div class="input-field col s6">
            <i class="material-icons prefix">schedule</i>
            <label asp-for="HorarioAtencionDesde">HorarioAtencionDesde</label>
            <input type="text" asp-for="HorarioAtencionDesde" class="timepicker" disabled>
            <span asp-validation-for="HorarioAtencionDesde"></span>
        </div>
        <div class="input-field col s6">
            <i class="material-icons prefix">schedule</i>
            <label asp-for="HorarioAtencionHasta">HorarioAtencionHasta</label>
            <input type="text" asp-for="HorarioAtencionHasta" class="timepicker" disabled>
            <span asp-validation-for="HorarioAtencionHasta"></span>
        </div>
        <div class="input-field col s6">
            <i class="material-icons prefix">star_rate</i>
            <select name="IdEspecialidad" asp-items="ViewBag.ListaEspecialidades" disabled>
                <option value="" disabled selected>Seleccione</option>
            </select>
        </div>
        <form asp-action="Delete">
            <div class="row center">
                <div class="col s6">
                    <a class="waves-effect waves-light btn grey darken-3 " asp-action="Index"><i
                            class="material-icons left">undo</i>Regresar</a>
                </div>
                <div class="col s6">
                    <input type="hidden" asp-for="IdMedico" />
                    <button class="btn waves-effect waves-light cyan accent'4" type="submit" name="action">Eliminar
                        <i class="material-icons right">delete</i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
