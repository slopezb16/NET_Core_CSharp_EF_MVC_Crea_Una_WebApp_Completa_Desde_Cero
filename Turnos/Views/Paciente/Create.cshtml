@model Turnos.Models.Paciente

<h4>Crear Paciente</h4>
<hr />
<div>
    <form class="col s12" asp-action="Create">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="row">
            <div class="input-field col s6">
                <i class="material-icons prefix">account_circle</i>
                <input asp-for="Nombre" type="text" class="validate">
                <label asp-for="Nombre">Nombre</label>
                <span asp-validation-for="Nombre" class="red-text"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">account_circle</i>
                <input asp-for="Apellido" type="text" class="validate">
                <label asp-for="Apellido">Apellido</label>
                <span asp-validation-for="Apellido" class="red-text"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">share_location</i>
                <input asp-for="Direccion" type="text" class="validate">
                <label asp-for="Direccion"></label>
                <span asp-validation-for="Direccion" class="red-text"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">phone</i>
                <input asp-for="Telefono" type="tel" class="validate">
                <label asp-for="Telefono"></label>
                <span asp-validation-for="Telefono" class="red-text"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">local_post_office</i>
                <input asp-for="Email" type="email" class="validate">
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="red-text"></span>
            </div>
        </div>
        <div class="row center">
            <div class="col s6">
                <a class="waves-effect waves-light btn grey darken-3 " asp-action="Index"><i
                        class="material-icons left">undo</i>Regresar</a>
            </div>
            <div class="col s6">
                <button class="btn waves-effect waves-light cyan accent'4" type="submit" name="action">Guardar
                    <i class="material-icons right">send</i>
                </button>
            </div>
        </div>
    </form>
</div>