@model Turnos.Models.Paciente

<h4>Editar Paciente</h4>
<hr />
<div>
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IdPaciente" />
        <div class="row">
            <div class="input-field col s6">
                <i class="material-icons prefix">account_circle</i>
                @* Ponemos el label y el input con el nombre del id en este caso la descipcion *@
                <input asp-for="Nombre" type="text" class="validate">
                <label asp-for="Nombre">Nombre</label>
                @* Lo usamos para que en conjunto con el asp-validation-summary revise el campo *@
                <span asp-validation-for="Nombre"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">account_circle</i>
                <input asp-for="Apellido" type="text" class="validate">
                <label asp-for="Apellido">Apellido</label>
                <span asp-validation-for="Apellido"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">share_location</i>
                <input asp-for="Direccion" type="text" class="validate">
                <label asp-for="Direccion">Direccion</label>
                <span asp-validation-for="Direccion"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">phone</i>
                <input asp-for="Telefono" type="tel" class="validate">
                <label asp-for="Telefono">Telefono</label>
                <span asp-validation-for="Telefono"></span>
            </div>
            <div class="input-field col s6">
                <i class="material-icons prefix">local_post_office</i>
                <input asp-for="Email" type="email" class="validate">
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email"></span>
            </div>
        </div>
        <div class="row center">
            <div class="col s6">
                <a class="waves-effect waves-light btn grey darken-3 " asp-action="Index"><i
                        class="material-icons left">undo</i>Regresar</a>
            </div>
            <div class="col s6">
                <button class="btn waves-effect waves-light cyan accent'4" type="submit" name="action">Editar
                    <i class="material-icons right">edit</i>
                </button>
            </div>
        </div>
    </form>
</div>